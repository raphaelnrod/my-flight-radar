{
  "name": "flight-radar",
  "version": "1.0.0",
  "description": "Monitoramento autônomo de passagens aéreas com alertas via Telegram",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "once": "node dist/index.js --once",
    "dev": "tsx src/index.ts",
    "dev:once": "tsx src/index.ts --once",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "11.1.2",
    "dotenv": "^18.0.5",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
