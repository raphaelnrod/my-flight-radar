# --- Telegram (obrigatório, exceto com DRY_RUN=true) ---
# Crie o bot com @BotFather; descubra o chat id enviando uma mensagem ao bot e abrindo
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = não envia nada, apenas registra os alertas no log
DRY_RUN=false

# --- Agendamento ---
# Sintaxe cron; padrão = a cada 3 horas
CRON_SCHEDULE=0 */3 * * *
TIMEZONE=America/Sao_Paulo
# Executa um ciclo imediatamente ao iniciar
RUN_ON_START=true

# --- Rotas e dados ---
ROUTES_FILE=config/routes.json
DB_PATH=data/flight-radar.db
HISTORY_RETENTION_DAYS=90

# --- Provedores (ordem = prioridade; os seguintes são fallback quando o anterior falha) ---
# Opções: google-flights (grátis, padrão), serpapi, amadeus
PROVIDERS=google-flights
SERPAPI_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test | production
AMADEUS_ENV=test

CURRENCY=BRL
ADULTS=1
# Pausa aleatória entre buscas (evita bloqueio do Google)
REQUEST_DELAY_MIN_MS=2000
REQUEST_DELAY_MAX_MS=6000
# Teto de buscas por rota em cada ciclo (pode ser sobrescrito por rota com "maxSearches")
MAX_SEARCHES_PER_ROUTE=30

# --- Regras de alerta ---
COOLDOWN_HOURS=12
DROP_PERCENT=15
DROP_WINDOW_DAYS=7
# Mínimo de coletas na janela para valer a regra de queda vs. média
DROP_MIN_SAMPLES=3

# --- Logs (pino) ---
LOG_LEVEL=info
# true = saída colorida legível (use só em desenvolvimento; requer devDependencies)
LOG_PRETTY=false
